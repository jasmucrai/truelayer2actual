# TrueLayer — from console.truelayer.com
# Use sandbox- prefix client IDs for testing
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/callback

# Actual Budget
ACTUAL_SERVER_URL=http://your-nas:5006
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_ENCRYPTION_PASSWORD=   # optional — only if E2E encryption is enabled

# If Actual uses a self-signed cert:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Sync behaviour
SYNC_DAYS_LOOKBACK=7
SYNC_INTERVAL_HOURS=6   # always-on scheduler interval (0/unset = 6). For sync.js only: 0 = one-shot
SETUP_PORT=3000

# Always-on dashboard (npm run serve)
PORT=3000                              # falls back to SETUP_PORT, then 3000
#DASHBOARD_URL=                        # public URL of the dashboard; used for notification
                                       # click-through links (optional) and the origin check
#ALLOWED_HOSTS=                        # extra hostnames the dashboard may be reached by, comma-
                                       # separated. IPs, localhost, single-label, .local, .lan,
                                       # .home.arpa and .ts.net names are always allowed.
REAUTH_WARN_DAYS=14                    # notify when consent expires within this many days

# Notifications (both optional)
NTFY_URL=                              # full topic URL, e.g. https://ntfy.sh/my-topic
HA_WEBHOOK_URL=                        # Home Assistant webhook URL
