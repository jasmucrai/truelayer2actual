# TrueLayer — from console.truelayer.com
# Use sandbox- prefix client IDs for testing
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/callback

# Actual Budget
ACTUAL_SERVER_URL=http://your-nas:5006
ACTUAL_PASSWORD=
# default budget sync id (optional if you add budgets during setup)
ACTUAL_SYNC_ID=
# optional — only if E2E encryption is enabled
ACTUAL_ENCRYPTION_PASSWORD=

# If Actual is served over HTTPS with a self-signed cert, trust just that CA.
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0: it disables certificate validation
# for every outbound request, including TrueLayer auth and data calls.
# NODE_EXTRA_CA_CERTS=/path/to/actual-ca.pem

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Sync behaviour
SYNC_DAYS_LOOKBACK=7
# always-on scheduler interval (0/unset = 6). For sync.js only: 0 = one-shot
SYNC_INTERVAL_HOURS=6
SETUP_PORT=3000

# Always-on dashboard (npm run serve)
# falls back to SETUP_PORT, then 3000
PORT=3000
# public URL of the dashboard; used for notification
# click-through links (optional) and the origin check
#DASHBOARD_URL=
# extra hostnames the dashboard may be reached by, comma-
# separated. IPs, localhost, single-label, .local, .lan,
# .home.arpa and .ts.net names are always allowed.
#ALLOWED_HOSTS=
# notify when consent expires within this many days
REAUTH_WARN_DAYS=14

# Notifications (both optional)
# full topic URL, e.g. https://ntfy.sh/my-topic
NTFY_URL=
# Home Assistant webhook URL
HA_WEBHOOK_URL=
