# Secrets and runtime state
.env
.env.*
data/

# Dependencies (reinstalled in the image with npm ci)
**/node_modules

# Build output (the image compiles its own)
**/dist
**/build
coverage/

# Version control and CI
.git
.gitignore
.github

# Docs
*.md

# Editor and OS junk
.vscode
.idea
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Docker files (Docker still reads them; they just don't need to be in the context)
Dockerfile*
docker-compose*
compose*
.dockerignore