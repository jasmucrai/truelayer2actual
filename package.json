{
  "name": "truelayer2actual",
  "type": "module",
  "version": "1.0.0",
  "description": "Sync TrueLayer bank transactions to Actual Budget",
  "scripts": {
    "setup": "tsx src/commands/setup.ts",
    "sync": "tsx src/commands/sync.ts",
    "serve": "tsx src/commands/serve.ts",
    "build": "tsc --outDir dist",
    "start:setup": "node dist/commands/setup.js",
    "start:sync": "node dist/commands/sync.js",
    "start:serve": "node dist/commands/serve.js",
    "test": "node --import tsx/esm --test test/*.test.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "axios": "^1",
    "dotenv": "^16",
    "express": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/express": "^4",
    "@types/node": "^20",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
